{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "TaskCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "source_type", "source_text"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "source_type": {"$ref": "common.json#/$defs/SourceType"},
        "source_text": {"type": "string"}
      }
    },
    "TaskPatch": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"type": "string", "enum": ["new", "paused", "trash"]}}},
    "TaskResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "title", "description", "source_type", "source_text", "status", "assigned_agent_id", "lease_id", "lease_expires_at", "plan_text", "plan_revision", "plan_decision", "plan_feedback", "result_summary", "result_data", "checkpoint", "created_at", "updated_at", "completed_at", "events", "skill_snapshots"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "project_id": {"type": "string", "format": "uuid"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "source_type": {"$ref": "common.json#/$defs/SourceType"},
        "source_text": {"type": "string"},
        "status": {"$ref": "common.json#/$defs/TaskStatus"},
        "assigned_agent_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
        "lease_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
        "lease_expires_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "plan_text": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "plan_revision": {"type": "integer", "minimum": 0},
        "plan_decision": {"$ref": "common.json#/$defs/PlanDecision"},
        "plan_feedback": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "result_summary": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "result_data": {"anyOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
        "checkpoint": {"anyOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "completed_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "events": {"type": "array", "items": {"$ref": "tasks.json#/$defs/TaskEventResponse"}},
        "skill_snapshots": {"type": "array", "items": {"$ref": "tasks.json#/$defs/TaskSkillSnapshotResponse"}}
      }
    },
    "TaskEventResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_id", "agent_id", "event_id", "event_type", "message", "payload", "created_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "task_id": {"type": "string", "format": "uuid"},
        "agent_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
        "event_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "event_type": {"type": "string"},
        "message": {"type": "string"},
        "payload": {"anyOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "TaskSkillSnapshotResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_id", "skill_id", "skill_name", "category", "skill_version", "content_hash", "content"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "task_id": {"type": "string", "format": "uuid"},
        "skill_id": {"type": "string", "format": "uuid"},
        "skill_name": {"type": "string"},
        "category": {"type": "string"},
        "skill_version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string"},
        "content": {"type": "string"}
      }
    },
    "PlanDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"decision": {"const": "rejected"}}}, "then": {"required": ["feedback"], "properties": {"feedback": {"type": "string", "minLength": 1}}}}],
      "required": ["decision"],
      "properties": {
        "decision": {"type": "string", "enum": ["approved", "rejected", "trash"]},
        "feedback": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "ResultDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"decision": {"const": "rework"}}}, "then": {"required": ["feedback"], "properties": {"feedback": {"type": "string", "minLength": 1}}}}],
      "required": ["decision"],
      "properties": {
        "decision": {"type": "string", "enum": ["publish", "rework", "keep_ready"]},
        "feedback": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "ExecutionStateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status", "plan_decision", "plan_revision", "plan_feedback", "result_feedback", "publication_requested", "lease_id", "lease_expires_at"],
      "properties": {
        "checkpoint": {"anyOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
        "task_id": {"type": "string", "format": "uuid"},
        "status": {"$ref": "common.json#/$defs/TaskStatus"},
        "plan_decision": {"$ref": "common.json#/$defs/PlanDecision"},
        "plan_revision": {"type": "integer", "minimum": 0},
        "plan_feedback": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "result_feedback": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "publication_requested": {"type": "boolean"},
        "lease_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
        "lease_expires_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    }
  }
}

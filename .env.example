# Copy to .env for non-secret Compose settings. Secret values belong in files under
# .secrets/ (mode 0750, files 0440); see deploy/README.md. Never commit either.
# Group that owns secret files and can be read by the unprivileged app UID.
SECRETS_GID=1000

# PostgreSQL identity; password is read from .secrets/postgres_password.
POSTGRES_DB=agents_flow
POSTGRES_USER=agents_flow
POSTGRES_VOLUME_NAME=agents-flow-postgres-data

# Database URL goes in .secrets/database_url and must match the DB identity above.
# Example format (replace PASSWORD):
# postgresql+psycopg://agents_flow:PASSWORD@db:5432/agents_flow (local)
# postgresql+psycopg://agents_flow:PASSWORD@agents-flow-db:5432/agents_flow (Dokploy)

# Set the admin email; initial admin password is read from .secrets/admin_password.
ADMIN_EMAIL=admin@example.com

# Telegram and provider credentials are optional secret files. Leave the files empty
# when a provider is disabled. Non-secret provider configuration follows.
TRANSCRIPTION_PROVIDER=stub
TRANSCRIPTION_MODEL=whisper-1
PUBLIC_BASE_URL=http://localhost:8000
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_PROVIDER=stub
AGENT_MODEL=

# JSON list of trusted proxy IPs/CIDRs, e.g. ["172.20.0.2/32"]. Never use '*'.
TRUSTED_PROXY_IPS=[]

# Optional listener and image tag.
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8000
SERVER_IMAGE=agents-flow-server:local

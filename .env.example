# Required: SQLAlchemy database URL.
DATABASE_URL=postgresql+psycopg://user:password@localhost/agents_flow
# Required: generate with python3 -c "import secrets;print(secrets.token_urlsafe(48))" (at least 32 bytes).
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Optional: set both to create the first administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: Telegram integration; leave empty to disable.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret
# Optional: transcription settings; provider defaults to stub.
TRANSCRIPTION_PROVIDER=stub
TRANSCRIPTION_API_KEY=replace-with-transcription-api-key
# Optional: public HTTP(S) base URL returned to Harness.
PUBLIC_BASE_URL=http://localhost:8000
# Optional: OpenAI integration.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: agent runtime settings; provider defaults to stub.
AGENT_PROVIDER=stub
AGENT_MODEL=replace-with-agent-model
# Optional: comma-separated trusted proxy IPs. Keep empty for direct access.
TRUSTED_PROXY_IPS=

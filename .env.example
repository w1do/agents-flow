# Переменные окружения харнесса. Скопировать в .env (файл не коммитится) и заполнить.
# Секреты здесь пустые: их значения задаются в ENV Dokploy или в локальном .env.
# Формат: ИМЯ=значение. Обязательные переменные помечены «обязательная».

# --- Обязательные (ядро и Telegram) ---

# Postgres (asyncpg). Обязательная, с этапа mvp-02. Содержит пароль: секрет.
# Совпадает с командой docker run из docs/development.md (локальная БД на 127.0.0.1:5432).
DATABASE_URL=postgresql+asyncpg://harness:CHANGE_ME@localhost:5432/harness
# Путь к harness.yaml. Обязательная, с этапа mvp-02.
HARNESS_CONFIG=config/harness.yaml
# Соль и ключ для хешей токенов. Обязательная, с этапа mvp-02. Секрет.
# Не короче 32 символов. Сгенерировать: openssl rand -hex 32
HARNESS_SECRET_KEY=
# Бот Telegram. Обязательная, с этапа mvp-02. Секрет.
TELEGRAM_BOT_TOKEN=
# Id чата-владельца. Обязательная, с этапа mvp-02. Положительный числовой id личного чата владельца; группы не поддерживаются (D-30).
TELEGRAM_CHAT_ID=
# Секрет webhook Telegram. Обязательная, с этапа mvp-02. Секрет.
# От 32 до 256 символов: только A-Z, a-z, 0-9, _ и -. Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Адрес Bot API. Необязательная. Прокси владельца (например, Cloudflare Worker), если сервер не достаёт
# api.telegram.org, например в РФ. Только https, без учётных данных, query и fragment. Пусто = https://api.telegram.org (D-61).
# Прокси видит токен бота: используйте только свой Worker и не включайте логи URL и тел запросов.
TELEGRAM_API_URL=
# Адрес, на который Telegram шлёт апдейты (маршрут Worker /tg-webhook). Необязательная: пусто = HARNESS_PUBLIC_URL/telegram/webhook.
# Те же правила, что у TELEGRAM_API_URL. Учитывается командой set-webhook (D-61).
TELEGRAM_WEBHOOK_URL=

# --- Опциональные: используются этапами, которые их вводят ---

# Публичный HTTPS-адрес сервера (адрес webhook для set-webhook, MCP-конфиг песочницы). С этапа mvp-04/mvp-07.
HARNESS_PUBLIC_URL=
# Временный операторский bearer для POST /tasks. Секрет. С этапа mvp-03.
HARNESS_ADMIN_TOKEN=

# Классификация Polza (OpenAI-совместимый API), базовый URL по умолчанию https://polza.ai/api/v1. С этапа mvp-05.
POLZA_AI_URL=
# Ключ Polza. Секрет. С этапа mvp-05.
POLZA_AI_KEY=
# Модель классификации, id вида provider/model (D-55).
POLZA_AI_MODEL=anthropic/claude-haiku-5.5
# Порог уверенности классификации, от 0 до 1; по умолчанию 0.6. С этапа mvp-05.
ROUTING_MIN_CONFIDENCE=0.6

# Распознавание речи. С этапа mvp-04.
# STT_PROVIDER: только openai (OpenAI-совместимый протокол) или пусто.
STT_PROVIDER=
STT_API_URL=
# Ключ STT. Секрет. С этапа mvp-04.
STT_API_KEY=
STT_MODEL=
# Лимит размера голосового файла в байтах. По умолчанию и максимум 20 МиБ (20971520). С этапа mvp-04.
VOICE_MAX_BYTES=

# Песочницы Novita. С этапа mvp-06.
# Ключ Novita. Секрет.
NOVITA_API_KEY=
NOVITA_DOMAIN=

# GitLab: push и MR. С этапа mvp-09.
GITLAB_URL=
# Токен GitLab. Секрет. С этапа mvp-09.
GITLAB_TOKEN=

# Токен подписки Claude Code для песочницы (claude setup-token). Секрет. С этапа mvp-06.
CLAUDE_CODE_OAUTH_TOKEN=

# Лимиты времени агента и гейта тестов, в минутах. С этапов mvp-06 и mvp-09.
AGENT_RUN_TIMEOUT_MIN=60
TESTS_TIMEOUT_MIN=15

# Пауза между опросами агента в worker, в секундах (> 0). С этапа mvp-06.
AGENT_POLL_INTERVAL_SEC=15

# Интервал опроса очереди worker, в секундах (больше 0). С этапа mvp-03.
WORKER_POLL_INTERVAL_SEC=5

# Консоль администратора. После MVP.
ADMIN_EMAIL=
# Пароль администратора консоли. Секрет. После MVP.
ADMIN_PASSWORD=

# --- Postgres для стека deploy/db (локальный запуск через --env-file .env) ---

POSTGRES_DB=harness
POSTGRES_USER=harness
# Пароль Postgres. Секрет. Должен совпадать с паролем в DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME

# --- Vault с ключами владельца (D-45, sandbox-profile): MCP по Streamable HTTP ---

# Адрес MCP-сервера vault. Только https. Пусто — ссылки vault:… не разрешаются.
VAULT_MCP_URL=
# Bearer-токен для MCP-сервера vault. Секрет.
VAULT_MCP_TOKEN=
